<mvc:View
    controllerName="com.raunak.products.controller.App"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
>
    <Shell>
        <App class="myProductsList">
            <Page
                class="sapUiResponsiveContentPadding"
                title="{i18n>appTitle}"
            >
                <List
                    id="idProductList"
                    noDataText="{i18n>noDataText}"
                    class="sapUiSmallMarginTop listWithSmallerTitle"
                    mode="Delete"
                    delete="onPressDelete"
                >
                    <headerToolbar>
                        <Toolbar>
                            <Title text="{i18n>listHeader}" />
                            <ToolbarSpacer />
                            <Button
                                icon="sap-icon://add"
                                press="onPressAddNewProduct"
                            />
                        </Toolbar>
                    </headerToolbar>
                </List>
            </Page>
        </App>
    </Shell>
</mvc:View>
