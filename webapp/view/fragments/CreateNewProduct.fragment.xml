<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core"
>
    <Dialog
        title="{i18n>createNewProduct}"
        contentWidth="800px"
    >
        <content>
            <form:SimpleForm
                layout="ResponsiveGridLayout"
                editable="true"
                breakpointM="600"
                breakpointL="1024"
                breakpointXL="1440"
                emptySpanM="0"
                emptySpanL="1"
                emptySpanXL="1"
                labelSpanS="12"
                labelSpanM="3"
                labelSpanL="4"
                labelSpanXL="4"
            >
                <form:content>
                    <core:Title text="{i18n>productDetails}" />
                    <Label text="{i18n>productName}" />
                    <Input
                        id="idProductName"
                        maxLength="40"
                    />
                    <Label text="{i18n>category}" />
                    <ComboBox
                        id="idCategory"
                        placeholder="{i1n8>category}"
                    >
                        <items>
                            <core:Item
                                key=""
                                text=""
                            />
                            <core:Item
                                key="0"
                                text="Food"
                            />
                            <core:Item
                                key="1"
                                text="Beverages"
                            />
                            <core:Item
                                key="2"
                                text="Electronics"
                            />
                        </items>
                    </ComboBox>
                    <Label text="{i18n>price}" />
                    <Input
                        id="idPrice"
                        type="Number"
                    />
                    <Input
                        value="INR"
                        editable="false"
                    >
                        <layoutData>
                            <layout:GridData span="XL1 L2 M3 S12" />
                        </layoutData>
                    </Input>
                    <core:Title text="{i18n>dates}" />
                    <Label text="{i18n>releaseDate}" />
                    <DatePicker id="idReleaseDate" />
                    <Label text="{i18n>disocntinuedDate}" />
                    <DatePicker id="idDiscontinuedDate" />
                </form:content>
            </form:SimpleForm>
        </content>
        <beginButton>
            <Button
                type="Emphasized"
                text="{i18n>buttonTextCreate}"
                press="onPressCreateNewProduct"
            />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>cancel}"
                press="onCancelNewProduct"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
